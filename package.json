{
  "name": "bunyan",
  "private": true,
  "description": "بُنيان — منصة البنية المؤسسية للجهات الحكومية",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:setup": "node scripts/db-setup.mjs",
    "db:demo": "node scripts/db-setup.mjs --demo --reset",
    "build": "npm --workspace apps/api run build && npm --workspace apps/web run build",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "test": "npm --workspace apps/api test"
  },
  "devDependencies": {
    "bcryptjs": "^3.0.3",
    "pg": "^8.23.1"
  },
  "engines": {
    "node": ">=22"
  }
}