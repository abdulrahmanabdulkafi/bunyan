# Copy to .env and change every value before any shared deployment.
POSTGRES_PASSWORD=change-me
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app
# Long random string that signs session tokens: openssl rand -base64 48
JWT_SECRET=generate-a-long-random-string
# 32 random bytes, base64 — encrypts connector credentials: openssl rand -base64 32
CONNECTOR_KEY=

# Database setup: leave empty for a real installation; --demo loads two demo entities and their users.
SETUP_FLAGS=

# Account security (NCA ECC 2-2). Defaults shown.
# Roles that must use two-step verification (TOTP); "none" turns the requirement off.
MFA_REQUIRED_ROLES=R0,R1,R2
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
PASSWORD_MIN_LENGTH=12
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Address the web interface is served from (CORS).
CORS_ORIGIN=http://localhost:3000
# The web server sends HSTS in production; set HSTS=off only when it is served over plain HTTP for testing.
HSTS=

# Optional SSO (Keycloak realm URL), e.g. https://sso.example.gov.sa/realms/bunyan
OIDC_ISSUER=
OIDC_AUDIENCE=bunyan

# E-mail notifications (approval workflow, cycle tasks and phases). Empty = in-app notifications only.
# e.g. smtps://user:password@smtp.example.gov.sa:465
SMTP_URL=
SMTP_FROM=Bunyan <no-reply@entity.gov.sa>
# Public address of the web interface, used for links in e-mails.
APP_URL=https://bunyan.entity.gov.sa
